{
  "name": "event-search",
  "version": "1.0.0",
  "description": "Modular TypeScript scraper for brewery/winery/restaurant event pages",
  "main": "dist/index.js",
  "bin": {
    "event-scrape": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "scrape": "ts-node src/cli/index.ts",
    "validate": "ts-node src/cli/index.ts validate",
    "test-scraper": "ts-node src/cli/index.ts test-scraper",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "scraper",
    "events",
    "brewery",
    "winery",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.21.1",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "ical-generator": "^11.1.3",
    "ical.js": "^2.2.1",
    "playwright": "^1.65.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
